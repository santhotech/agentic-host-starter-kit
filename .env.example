# Which LLM drives the agent. "anthropic" (default) or "mock" (scripted, no API key, for tests)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Any Claude model id your key can use
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ports. The sandbox MUST be a different origin from the web app (different port is enough locally).
HOST_PORT=8787
SANDBOX_PORT=8788
WEB_PORT=5173

# Origins allowed to embed the sandbox (comma separated). Default allows localhost / 127.0.0.1 on any port.
# ALLOWED_HOST_ORIGINS=https://myapp.example.com
